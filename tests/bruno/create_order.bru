meta {
  name: Create Order
  type: http
}

request {
  url: http://localhost:8000/orders/create-order
  method: POST

  body: json({
    "token": "{{TOKEN}}",
    "title": "Test Order {{random 10}}",
    "description": "Some description",
    "category_id": 0,
    "price": 100,
    "price_max": 200,
    "time_start": "2025-02-10 10:00:00",
    "time_end": "2025-02-20 10:00:00",
    "is_visible": true
  })
}
